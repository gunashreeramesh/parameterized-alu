# Virtual clock
create_clock -name clk -period 10

# Input delays
set_input_delay 2 -clock clk [get_ports A]
set_input_delay 2 -clock clk [get_ports B]
set_input_delay 2 -clock clk [get_ports op]

# Output delays
set_output_delay 2 -clock clk [get_ports Y]
set_output_delay 2 -clock clk [get_ports Zero]
set_output_delay 2 -clock clk [get_ports Carry]
set_output_delay 2 -clock clk [get_ports Borrow]
set_output_delay 2 -clock clk [get_ports Negative]
set_output_delay 2 -clock clk [get_ports Overflow]

# Output load
set_load 0.05 [all_outputs]
